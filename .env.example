# Copy to .env and adjust. The server reads plain process env — on Windows:
#   $env:ADMIN_PASS = "..."; npm start
# On a host (Railway, Fly, systemd) set these as environment variables.

# --------------------------------------------------------------------- required
# Admin panel at /admin. The panel shows every customer's name, phone number
# and address. With NODE_ENV=production the server REFUSES TO START while this
# is still the default "admin".
ADMIN_USER=admin
ADMIN_PASS=admin

# ------------------------------------------------------------ baza (Vercel üçün)
# Serverless-də disk müvəqqətidir, ona görə SQLite faylı işləmir. Turso təyin
# etsən server ona qoşulur; təyin etməsən lokal fayla (DATA_DIR) yazır.
# TURSO_DATABASE_URL=libsql://ozcayin-<org>.turso.io
# TURSO_AUTH_TOKEN=...

# --------------------------------------------------------------------- optional
# Turns on the production guards: the admin-password check, X-Forwarded-For
# trust, and quieter startup output. Every host sets this for you as a rule.
NODE_ENV=production

# Port and bind address. Most hosts inject PORT themselves — leave it unset there.
PORT=8787
HOST=0.0.0.0

# Where orders.db lives — only used when TURSO_DATABASE_URL is NOT set. Point it
# at a mounted volume in production, or the database is lost on the next deploy.
# Defaults to server/data/ next to the code.
DATA_DIR=/data

# Where `npm run backup` writes snapshots, and how many it keeps.
BACKUP_DIR=/data/backups
BACKUP_KEEP=14

# Orders one IP address may place per hour before it is asked to phone instead.
RATE_LIMIT=12

# How many reverse proxies sit in front of the process. Express counts hops from
# the right of X-Forwarded-For, so this has to be exact: too low and every
# visitor looks like the proxy, too high and a client can spoof its address and
# walk past RATE_LIMIT. One load balancer (Railway, Fly, a single nginx) = 1.
# Defaults to 1 under NODE_ENV=production, 0 otherwise.
TRUST_PROXY=1
